{
  "name": "test",
  "version": "0.1.0",
  "type": "module",
  "description": "sandbox project for rapid and destructive prototyping",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaidlab/test.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "imports": {
    "#/*": "./*",
    "#root/*": "./*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "bun x rolldown --config",
    "test": "bun test --max-concurrency 1 ./test ./packages/*/test"
  },
  "dependencies": {
    "bundil": "workspace:*",
    "minify-dts": "workspace:*",
    "rolldown-plugin-bundil": "workspace:*",
    "rolldown-plugin-license": "workspace:*",
    "rolldown-plugin-minify": "workspace:*",
    "rolldown-plugin-minify-dts": "workspace:*",
    "rolldown-plugin-publishimo": "workspace:*",
    "rolldown-plugin-readme": "workspace:*",
    "eslint-plugin-minify-dts": "workspace:*"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.0.1",
    "bun-types": "^1.3.12",
    "eslint": "^10.2.0",
    "eslint-config-jaid": "^25.0.0",
    "rolldown": "^1.0.2",
    "rolldown-plugin-dts": "^0.25.1",
    "rollup-plugin-stats": "^2.1.2",
    "tsconfig-jaid-bun": "^13.0.0",
    "typescript": "^6.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
